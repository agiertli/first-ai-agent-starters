{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "predev": "python3 ../package_starters.py",
    "dev": "vite --mode static --port 5174",
    "prebuild": "python3 ../package_starters.py",
    "build": "tsc -b && vite build --mode static",
    "preview": "vite preview --mode static --port 4174",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "lint": "oxlint",
    "stage": "npm run build && node ../publish.mjs"
  },
  "dependencies": {
    "framer-motion": "^14.4.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "oxlint": "^1.88.0",
    "typescript": "~7.0.2",
    "vite": "^8.3.4"
  }
}
